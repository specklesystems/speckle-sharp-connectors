<Project Sdk="Microsoft.NET.Sdk">
  <!-- DUI3 host for Rhino 8 Mac: Eto.Forms WebView (WKWebView) instead of WPF + WebView2. Eto ships inside the
       RhinoCommon package; this project is only consumed by .NET Core Rhino heads on macOS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Configurations>Debug;Release;Local</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="RhinoCommon"
      IncludeAssets="compile; build"
      PrivateAssets="all"
      VersionOverride="8.31.26126.13431"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Speckle.Connectors.DUI\Speckle.Connectors.DUI.csproj" />
  </ItemGroup>
</Project>
