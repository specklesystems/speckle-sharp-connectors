<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWpf>true</UseWpf>
    <FileAlignment>512</FileAlignment>

    <BentleyProductFolder>OpenRoadsDesigner</BentleyProductFolder>
    <BentleyProductVersion>2025</BentleyProductVersion>
    <!--
      Per-user prefs subfolder = MicroStation platform version (25.0.0 for OpenRoads 2025),
      NOT the OpenRoads product version (10.13.x). Bentley creates BOTH folders under
      %LOCALAPPDATA%\Bentley\OpenRoadsDesigner\, but only the platform-version one
      (25.0.0\prefs\) is read for cfg loading at startup.
    -->
    <BentleyPrefsVersion>25.0.0</BentleyPrefsVersion>
    <DefineConstants>$(DefineConstants);TRACE;OPENROADSDESIGNER;OPENROADSDESIGNER_2025</DefineConstants>
    <Configurations>Debug;Release;Local</Configurations>

    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);CA1031;IDE0051</NoWarn>
    <Description>Speckle Connector for Bentley OpenRoads Designer 2025</Description>
    <AssemblyName>Speckle.Connectors.OpenRoadsDesigner2025</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <OpenRoadsDesigner2025Dir Condition="'$(OpenRoadsDesigner2025Dir)' == ''">$(ProgramFiles)\Bentley\OpenRoads Designer 2025.00\OpenRoadsDesigner\</OpenRoadsDesigner2025Dir>
  </PropertyGroup>

  <Import
    Project="..\Speckle.Connectors.MicroStationShared\Speckle.Connectors.MicroStationShared.projitems"
    Label="Shared"
  />
  <Import
    Project="..\Speckle.Connectors.OpenRoadsDesignerShared\Speckle.Connectors.OpenRoadsDesignerShared.projitems"
    Label="Shared"
  />

  <ItemGroup>
    <Reference Include="ustation">
      <HintPath>$(OpenRoadsDesigner2025Dir)ustation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Bentley.DgnPlatformNET">
      <HintPath>$(OpenRoadsDesigner2025Dir)Bentley.DgnPlatformNET.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Bentley.Interop.MicroStationDGN">
      <HintPath>$(OpenRoadsDesigner2025Dir)Assemblies\Bentley.Interop.MicroStationDGN.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Converters\Bentley\Speckle.Converters.OpenRoadsDesigner2025\Speckle.Converters.OpenRoadsDesigner2025.csproj" />
    <ProjectReference Include="..\..\..\Sdk\Speckle.Connectors.Common\Speckle.Connectors.Common.csproj" />
    <ProjectReference Include="..\..\..\DUI3\Speckle.Connectors.DUI.WebView\Speckle.Connectors.DUI.WebView.csproj" />
  </ItemGroup>
</Project>
