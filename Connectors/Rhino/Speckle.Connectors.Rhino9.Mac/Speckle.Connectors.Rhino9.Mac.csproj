<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same shape as the Rhino8.Mac head, whose Mac-only sources are linked here rather than copied (FEA-124). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;Local</Configurations>
    <RhinoVersion>9</RhinoVersion>
    <DefineConstants>$(DefineConstants);RHINO_MAC;RHINO9;RHINO7_OR_GREATER;RHINO8_OR_GREATER;RHINO9_OR_GREATER</DefineConstants>
    <TargetExt>.rhp</TargetExt>
    <RootNamespace>Speckle.Connectors.Rhino</RootNamespace>
    <!-- Emits runtimes/ + deps.json so the osx natives (e_sqlite3, nironcompress) ship next to the .rhp -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shown in Rhino's own plug-in listing, so the "(Beta)" tag reaches users there, not just in docs. -->
    <Title>Speckle.Connectors.Rhino9.Mac (Beta)</Title>
    <Description>Speckle connector for Rhino 9 on macOS — Beta</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WPF heads get this using from UseWindowsForms, which this head can't set. -->
    <Using Include="System.Drawing" />
    <Using Remove="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="RhinoCommon"
      IncludeAssets="compile; build"
      PrivateAssets="all"
      VersionOverride="9.0.26300.9401"
    />
    <PackageReference Include="IronCompress" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Connectors\Rhino\Speckle.Connectors.Grasshopper9.Mac\Speckle.Connectors.Grasshopper9.Mac.csproj" />
    <ProjectReference Include="..\..\..\DUI3\Speckle.Connectors.DUI.EtoWebView\Speckle.Connectors.DUI.EtoWebView.csproj" />
    <ProjectReference Include="..\..\..\Converters\Rhino\Speckle.Converters.Rhino9\Speckle.Converters.Rhino9.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\Speckle.Connectors.Rhino9\EmbeddedResources\**\*"
      Link="EmbeddedResources\%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Speckle.Connectors.Rhino8.Mac\HostApp\*.cs" Link="HostApp\%(Filename)%(Extension)" />
    <Compile
      Include="..\Speckle.Connectors.Rhino8.Mac\MacNativeLibraryResolver.cs"
      Link="MacNativeLibraryResolver.cs"
    />
    <Compile Include="..\Speckle.Connectors.Rhino8.Mac\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <Import Project="..\Speckle.Connectors.RhinoShared\Speckle.Connectors.RhinoShared.projitems" Label="Shared" />

  <!-- The shared panel host derives from WpfElementHost; the Eto one is linked from the Rhino8.Mac head above. -->
  <ItemGroup>
    <Compile Remove="..\Speckle.Connectors.RhinoShared\HostApp\SpeckleRhinoPanelHost.cs" />
  </ItemGroup>
</Project>
