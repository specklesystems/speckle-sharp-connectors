<Project>
  <!-- net48: deploy IronCompress's native nironcompress.dll next to the Tekla plugin so Parquet.Net's Zstd codec
       resolves on .NET Framework (4.0 artefact send). Pre-loaded by full path in TeklaArtifactRootObjectBuilder.
       Tekla is net48-only; imported by Tekla2023/2024/2025. -->
  <ItemGroup>
    <PackageReference Include="IronCompress" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(PkgIronCompress)' != ''">
    <None Include="$(PkgIronCompress)\runtimes\win-x64\native\nironcompress.dll">
      <Link>nironcompress.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
</Project>
